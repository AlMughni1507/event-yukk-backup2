# ============================================
# BACKEND ENV VARS - LOCALHOST DEVELOPMENT
# ============================================

# Database Configuration (Local - Laragon)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=event_db
DB_PORT=3306

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
# ⚠️ GENERATE BARU - minimal 32 karakter untuk production!
JWT_SECRET=your-jwt-secret-here-min-32-chars
JWT_EXPIRES_IN=24h

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Admin seed key (for /api/auth/seed-admin)
# ⚠️ GENERATE BARU untuk production!
ADMIN_SEED_KEY=your-admin-seed-key-here

# Email Provider - Brevo (Transactional API + SMTP fallback)
# ⚠️ GANTI dengan API key Brevo yang sebenarnya di Railway Variables!
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_NAME=Event Yukk Platform
BREVO_SENDER_EMAIL=your-sender-email@example.com

# SMTP Fallback (Brevo Relay)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=${BREVO_SENDER_EMAIL}
SMTP_PASS=${BREVO_API_KEY}
SMTP_FROM_NAME=${BREVO_SENDER_NAME}
SMTP_FROM_EMAIL=${BREVO_SENDER_EMAIL}

# Midtrans Payment Gateway
# ⚠️ GANTI dengan production keys dari Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key-here
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key-here

# Frontend URL
# ✅ Sudah diisi dengan URL Railway
FRONTEND_URL=https://fronten.up.railway.app
